    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "reactflow": "^11.11.0",
    "recharts": "^2.10.0",
    "lucide-react": "^0.312.0",
    "tailwind-merge": "^2.2.0",
    "clsx": "^2.1.0"
