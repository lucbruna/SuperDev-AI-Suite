FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (curl needed for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Core backend (FastAPI application)
COPY backend/ ./backend/

# Modulos da nova arquitetura importados pelo backend em runtime
COPY core/ ./core/
COPY ai/ ./ai/
COPY monitoring/ ./monitoring/
COPY cli/ ./cli/

# Scanners e Security (analise estatica)
COPY scanners/ ./scanners/
COPY security/ ./security/

# Builders (templates de geracao de codigo)
COPY builders/ ./builders/

# Runtime engine e workflow (orquestracao)
COPY runtime_engine/ ./runtime_engine/
COPY workflow_engine/ ./workflow_engine/

# Modulos nativos (ex.: ai_video_studio) importados pelo backend em runtime
COPY modules/ ./modules/

# Alembic config (migracoes de banco executadas no startup)
COPY alembic.ini ./

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
