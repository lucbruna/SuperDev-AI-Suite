FROM node:20-alpine AS base
WORKDIR /app
# verify-deps-before-run=false: pnpm >= 10.13 re-verifies deps on every `pnpm run`
# and silently installs missing/outdated packages. Inside the build stage there is
# no pnpm-workspace.yaml/lockfile, so that implicit install ignores the approved
# build scripts (esbuild, unrs-resolver) and fails with ERR_PNPM_IGNORED_BUILDS.
# Classic behavior: `pnpm run` only runs the script; deps come from the deps stage.
RUN npm install -g pnpm \
  && echo "node-linker=hoisted" > /app/.npmrc \
  && echo "verify-deps-before-run=false" >> /app/.npmrc

# ── deps: Install dependencies with frozen lockfile ──────────────
FROM base AS deps
WORKDIR /app
# Copy ALL workspace package.json files to satisfy --frozen-lockfile
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/package.json
COPY sdk/typescript/package.json ./sdk/typescript/package.json
# Strictly reproducible install --frozen-lockfile verifies all specs match
RUN pnpm install --frozen-lockfile --filter superdev-frontend

# ── build: Compile the Next.js application ──────────────────────
FROM base AS build
WORKDIR /app
# Next.js resolves rewrites while building. In Docker, the backend must be
# addressed by its Compose service name rather than the frontend container.
ARG NEXT_PUBLIC_BACKEND_URL=http://backend:8000
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Copy hoisted dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules
# Copy frontend source directly to /app/
COPY frontend/ ./
# Build — outputs .next/ at /app/.next/
RUN pnpm run build

# ── runner: Production image ────────────────────────────────────
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# Copy built artifacts (all at /app/ level)
COPY --from=build /app/.next ./.next
COPY --from=build /app/public ./public
COPY --from=build /app/package.json ./
COPY --from=build /app/node_modules ./node_modules
EXPOSE 3000
# Run next start directly from CWD (/app/) where .next/ lives.
# pnpm start from root package.json does "cd frontend && npx next start"
# which fails because .next/ is at /app/.next/, not /app/frontend/.next/.
# Using npx directly ensures next finds .next/ in the current directory.
CMD ["npx", "next", "start"]
