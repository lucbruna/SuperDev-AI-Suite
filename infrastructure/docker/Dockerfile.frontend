FROM node:20-alpine AS base
WORKDIR /app
RUN npm install -g pnpm && echo "node-linker=hoisted" > .npmrc

# ── deps: Install dependencies with frozen lockfile ──────────────
FROM base AS deps
WORKDIR /app
# Copy ALL workspace package.json files to satisfy --frozen-lockfile
COPY pnpm-lock.yaml package.json pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/package.json
COPY sdk/typescript/package.json ./sdk/typescript/package.json
# Strictly reproducible install --frozen-lockfile verifies all specs match
RUN pnpm install --frozen-lockfile --filter superdev-frontend

# ── build: Compile the Next.js application ──────────────────────
FROM base AS build
WORKDIR /app
# Next.js resolves rewrites while building. In Docker, the backend must be
# addressed by its Compose service name rather than the frontend container.
ARG NEXT_PUBLIC_BACKEND_URL=http://backend:8000
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_API_URL=/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
# Take the whole installed workspace state (root + workspace node_modules).
# With hoisted workspaces the frontend's packages and bins live under
# frontend/node_modules — keep that layout instead of flattening the source
# into /app, which breaks Node module resolution.
COPY --from=deps /app ./
# Overlay the real frontend source into its original subdirectory
COPY frontend/ ./frontend/
# Call the next binary directly instead of `pnpm run build`: on pnpm >= 10.13,
# `pnpm run` re-verifies dependencies and implicitly installs packages when the
# local state looks stale, which would reject the esbuild/unrs-resolver build
# scripts (ERR_PNPM_IGNORED_BUILDS).
RUN cd frontend && node node_modules/next/dist/bin/next build

# ── runner: Production image ────────────────────────────────────
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# Keep the workspace layout: .next/ and dependencies stay under frontend/
COPY --from=build /app/frontend/.next ./frontend/.next
COPY --from=build /app/frontend/public ./frontend/public
COPY --from=build /app/frontend/package.json ./frontend/package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/frontend/node_modules ./frontend/node_modules
EXPOSE 3000
# Start next from the frontend directory where .next/ lives.
CMD ["sh", "-c", "cd frontend && exec node node_modules/next/dist/bin/next start"]
