root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

[*.{ts,tsx,mts,cts}]
indent_style = space
indent_size = 2

[*.json]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{md,markdown}]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.{bat,cmd,ps1}]
indent_style = space
indent_size = 4
end_of_line = crlf

[*.sh]
indent_style = space
indent_size = 4
end_of_line = lf
