# SuperDev AI Suite - Environment Configuration
# Copy this file to .env and adjust values for your environment

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=change-me-to-a-random-256-bit-secret
API_VERSION=v1
DEBUG=true
APP_NAME=SuperDev AI Suite
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
WORKERS=1

# =============================================================================
# DATABASE (PostgreSQL + pgvector)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://superdev:superdev@localhost:5432/superdev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true

# pgvector
PGVECTOR_DIMENSION=1536
PGVECTOR_IVFFLAT_LISTS=100

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=superdev
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_MAX_CONNECTIONS=50
REDIS_POOL_SIZE=10

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=X-Request-ID,X-Process-Time
CORS_MAX_AGE=3600

# =============================================================================
# AUTHENTICATION (OAuth2/OIDC + JWT)
# =============================================================================
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=superdev
JWT_AUDIENCE=superdev-api

# Password hashing
BCRYPT_ROUNDS=12

# OAuth2/OIDC Providers
OAUTH2_ENABLED=true
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OIDC_SCOPES=openid,profile,email

# GitHub OAuth
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# AI / LLM PROVIDERS
# =============================================================================
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenRouter (multiple models)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider Routing
DEFAULT_LLM_PROVIDER=openai
LLM_ROUTING_STRATEGY=auto  # cost_first, quality_first, latency_first, balanced, auto
LLM_COST_MAX_PER_1K=0.10
LLM_LATENCY_MAX_MS=5000

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# KNOWLEDGE BASE (Vector Search + RAG)
# =============================================================================
KNOWLEDGE_BASE_ENABLED=true
KB_VECTOR_DIMENSION=1536
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
KB_MIN_CHUNK_SIZE=100
KB_SIMILARITY_THRESHOLD=0.5
KB_TOP_K=10
KB_MAX_TOKENS_CONTEXT=8000

# =============================================================================
# RUNTIME / SANDBOX
# =============================================================================
RUNTIME_SANDBOX_TIMEOUT=300
RUNTIME_MAX_MEMORY_MB=512
RUNTIME_MAX_DISK_MB=1024
RUNTIME_MAX_CPU_SECONDS=60
RUNTIME_MAX_PROCESSES=50
RUNTIME_MAX_FILE_SIZE_MB=100
RUNTIME_ENABLE_NETWORK=false
RUNTIME_SANDBOX_IMAGE=superdev-sandbox:latest
RUNTIME_USE_DOCKER=false
RUNTIME_DOCKER_HOST=unix:///var/run/docker.sock
RUNTIME_SECCOMP_PROFILE=default
RUNTIME_DROP_CAPABILITIES=all
RUNTIME_USER_NAMESPACE=true
RUNTIME_UID_MAP=0:100000:65536
RUNTIME_GID_MAP=0:100000:65536

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=20
RATE_LIMIT_STRATEGY=sliding_window  # fixed_window, sliding_window, token_bucket

# =============================================================================
# MULTI-TENANCY
# =============================================================================
MULTI_TENANT_ENABLED=true
DEFAULT_ORG_ID=default
ORG_ISOLATION_LEVEL=schema  # schema, database, row

# =============================================================================
# PLUGINS / MARKETPLACE
# =============================================================================
PLUGINS_ENABLED=true
PLUGIN_DIR=./plugins
PLUGIN_MARKETPLACE_URL=https://marketplace.superdev.ai/api/v1
PLUGIN_AUTO_UPDATE=false
PLUGIN_SANDBOX_ENABLED=true
PLUGIN_SIGNING_REQUIRED=false
PLUGIN_MAX_MEMORY_MB=256
PLUGIN_MAX_CPU_SECONDS=30

# =============================================================================
# WORKFLOWS
# =============================================================================
WORKFLOW_ENABLED=true
WORKFLOW_MAX_CONCURRENT=10
WORKFLOW_DEFAULT_TIMEOUT=3600
WORKFLOW_MAX_RETRIES=3
WORKFLOW_CHECKPOINT_INTERVAL=60
WORKFLOW_STATE_TTL=86400

# =============================================================================
# VERIFICATION LOOP
# =============================================================================
VERIFICATION_ENABLED=true
VERIFICATION_MAX_ITERATIONS=3
VERIFICATION_GENERATION_TEMPERATURE=0.3
VERIFICATION_REVIEW_THRESHOLD=70
VERIFICATION_AUTO_FIX=true

# =============================================================================
# OBJECT STORAGE
# =============================================================================
STORAGE_BACKEND=local  # local, s3, gcs, azure
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=superdev-artifacts
S3_PREFIX=artifacts
LOCAL_STORAGE_PATH=./data/storage

# =============================================================================
# MONITORING / OBSERVABILITY
# =============================================================================
OTEL_SERVICE_NAME=superdev-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_RESOURCE_ATTRIBUTES=service.name=superdev-api,deployment.environment=development

PROMETHEUS_METRICS_ENABLED=true
PROMETHEUS_METRICS_PORT=9090
PROMETHEUS_PUSH_GATEWAY_URL=

# Grafana
GRAFANA_ENABLED=true
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=

# Jaeger
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_COLLECTOR_ENDPOINT=http://localhost:14268/api/traces

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# SUPPLY CHAIN SECURITY
# =============================================================================
SBOM_ENABLED=true
SBOM_FORMAT=spdx-json
COSIGN_ENABLED=false
COSIGN_KEY_PATH=
COSIGN_PASSWORD=
SLSA_LEVEL=1

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_KNOWLEDGE_BASE=true
FEATURE_VERIFICATION_LOOP=true
FEATURE_PLUGIN_MARKETPLACE=true
FEATURE_WORKFLOW_ENGINE=true
FEATURE_MULTI_TENANT=true
FEATURE_RATE_LIMITING=true
FEATURE_OBSERVABILITY=true
FEATURE_SUPPLY_CHAIN_SECURITY=false

# =============================================================================
# CI/CD
# =============================================================================
CI_REGISTRY=ghcr.io
CI_REGISTRY_USER=
CI_REGISTRY_PASSWORD=
CI_IMAGE_NAME=superdev/superdev
CI_IMAGE_TAG=latest

# =============================================================================
# KUBERNETES
# =============================================================================
K8S_NAMESPACE=superdev
K8S_CLUSTER_NAME=superdev-cluster
K8S_INGRESS_CLASS=nginx
K8S_CERT_MANAGER_ENABLED=true
K8S_CERT_ISSUER=letsencrypt-prod