# =============================================================================
# SuperDev AI Suite v5.0 - Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# SEED CREDENTIALS (development only - change in production!)
# -----------------------------------------------------------------------
# All seed users use the same password: SuperDev@2025
#
# | Email                    | Role               |
# |--------------------------|--------------------|
# | admin@superdev.com       | Super Admin        |
# | dev@superdev.com         | Developer          |
# | usuario@superdev.com     | Standard User      |


# =============================================================================
# APPLICATION  (prefix: APP_)
# =============================================================================
APP_NAME=SuperDev AI Suite
APP_VERSION=5.0.0
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_LOG_LEVEL=DEBUG
# Generate a strong value with:  openssl rand -hex 32
# The backend rejects known placeholder values, so leaving this unchanged
# will fail fast instead of running with a weak secret.
SECRET_KEY=
API_VERSION=v1
AI_MODEL=openai:gpt-4o

# =============================================================================
# DATABASE (PostgreSQL + pgvector)  (prefix: DATABASE_)
# =============================================================================
# Generate a strong password with:  openssl rand -hex 16
# Used by docker-compose (POSTGRES_PASSWORD) and by the backend URL below.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://superdev:${POSTGRES_PASSWORD}@localhost:5432/superdev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false
DATABASE_POOL_PRE_PING=true
DATABASE_CONNECT_TIMEOUT=10
DATABASE_STATEMENT_TIMEOUT=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=60000
DATABASE_LOCK_TIMEOUT=10000
DATABASE_READONLY_URL=
DATABASE_PGBOUNCER_URL=
PGVECTOR_DIMENSION=1536
PGVECTOR_IVFFLAT_LISTS=100

# =============================================================================
# REDIS  (prefix: REDIS_ - RedisSettings constructs url from host/port/password)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_SENTINEL_ENABLED=false
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_PASSWORD=
REDIS_SERVICE_NAME=mymaster
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=

# =============================================================================
# CORS  (prefix: CORS_)
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_EXPOSE_HEADERS=X-Request-ID,X-Process-Time
CORS_MAX_AGE=3600

# =============================================================================
# AUTHENTICATION (JWT + OAuth2/OIDC)  (prefix: JWT_)
# =============================================================================
# Generate a strong value with:  openssl rand -hex 32
# The backend rejects known placeholder values, so leaving this unchanged
# will fail fast instead of running with a weak secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=superdev
JWT_AUDIENCE=superdev-api
JWT_BCRYPT_ROUNDS=12
JWT_OAUTH2_ENABLED=true
JWT_OIDC_ENABLED=false
JWT_OIDC_ISSUER_URL=https://your-oidc-provider.com
JWT_OIDC_CLIENT_ID=
JWT_OIDC_CLIENT_SECRET=
JWT_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
JWT_OIDC_SCOPES=openid,profile,email
JWT_GITHUB_OAUTH_ENABLED=false
JWT_GITHUB_CLIENT_ID=
JWT_GITHUB_CLIENT_SECRET=
JWT_GOOGLE_OAUTH_ENABLED=false
JWT_GOOGLE_CLIENT_ID=
JWT_GOOGLE_CLIENT_SECRET=
JWT_SESSION_TTL_SECONDS=3600
JWT_SESSION_COOKIE_NAME=superdev_session
JWT_SESSION_COOKIE_SECURE=true
JWT_SESSION_COOKIE_HTTPONLY=true
JWT_SESSION_COOKIE_SAMESITE=lax

# =============================================================================
# AI / LLM PROVIDERS  (no prefix - field names match directly)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_PROVIDER=openai
LLM_ROUTING_STRATEGY=auto
LLM_COST_MAX_PER_1K=0.10
LLM_LATENCY_MAX_MS=5000
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# =============================================================================
# KNOWLEDGE BASE (Vector Search + RAG)  (prefix: KB_)
# =============================================================================
KB_ENABLED=true
KB_EMBEDDING_MODEL=all-MiniLM-L6-v2
KB_EMBEDDING_DIMENSION=384
KB_CHUNK_SIZE=1000
KB_CHUNK_OVERLAP=200
KB_MIN_CHUNK_SIZE=100
KB_SIMILARITY_THRESHOLD=0.5
KB_MAX_RESULTS=10
KB_MAX_CONTEXT_TOKENS=8000

# =============================================================================
# RUNTIME / SANDBOX  (prefix: RUNTIME_)
# =============================================================================
RUNTIME_SANDBOX_TIMEOUT=300
RUNTIME_MAX_MEMORY_MB=512
RUNTIME_MAX_DISK_MB=1024
RUNTIME_MAX_CPU_SECONDS=60
RUNTIME_MAX_PROCESSES=50
RUNTIME_MAX_FILE_SIZE_MB=100
RUNTIME_ENABLE_NETWORK=false
RUNTIME_SANDBOX_IMAGE=superdev-sandbox:latest
RUNTIME_USE_DOCKER=false
RUNTIME_DOCKER_HOST=unix:///var/run/docker.sock
RUNTIME_SECCOMP_PROFILE=default
RUNTIME_DROP_CAPABILITIES=all
RUNTIME_USER_NAMESPACE=true
RUNTIME_UID_MAP=0:100000:65536
RUNTIME_GID_MAP=0:100000:65536

# =============================================================================
# AUTONOMOUS DEVELOPER  (prefix: SUPERDEV_AD_)
# =============================================================================
# The Autonomous Developer module runs the bug-fix loop (plan → generate →
# test → review → merge). LLM planning is opt-in: leave enabled=false to use
# the deterministic planner. Keys below are optional; the module falls back to
# a deterministic plan when the provider is unreachable or misconfigured.
# In docker-compose, OLLAMA_URL defaults to http://host.docker.internal:11434
# so a host-side Ollama can serve the container.
SUPERDEV_AD_LLM_ENABLED=false
SUPERDEV_AD_LLM_PROVIDER=ollama
SUPERDEV_AD_LLM_MODEL=
SUPERDEV_AD_LLM_OLLAMA_URL=http://localhost:11434
SUPERDEV_AD_LLM_OPENAI_KEY=
SUPERDEV_AD_LLM_OPENAI_BASE_URL=https://api.openai.com/v1
SUPERDEV_AD_LLM_GEMINI_KEY=
SUPERDEV_AD_LLM_CLAUDE_KEY=
SUPERDEV_AD_LLM_TIMEOUT=60
SUPERDEV_AD_LLM_MAX_TOKENS=4096
SUPERDEV_AD_LLM_STREAM=false
SUPERDEV_AD_LLM_FALLBACK_ECHO=true
# Max risk level the generator may apply before writes are blocked
# (low | medium | high | critical).
SUPERDEV_AD_GENERATOR_MAX_RISK=critical
SUPERDEV_AD_RUN_TESTS=true
SUPERDEV_AD_RUN_REVIEW=true
SUPERDEV_AD_CREATE_PR=false

# =============================================================================
# LOGGING  (prefix: LOG_)
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_FILE_PATH=
LOG_ACCESS_LOG=true
LOG_SQL_LOG=false
LOG_CORRELATION_ID_HEADER=X-Request-ID

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BURST=20
RATE_LIMIT_STRATEGY=sliding_window

# =============================================================================
# MULTI-TENANCY
# =============================================================================
MULTI_TENANT_ENABLED=true
DEFAULT_ORG_ID=default
ORG_ISOLATION_LEVEL=schema

# =============================================================================
# PLUGINS / MARKETPLACE  (prefix: PLUGIN_)
# =============================================================================
PLUGIN_ENABLED=true
PLUGIN_DIR=./plugins
PLUGIN_MARKETPLACE_URL=https://marketplace.superdev.ai/api/v1
PLUGIN_MARKETPLACE_ENABLED=true
PLUGIN_AUTO_UPDATE=false
PLUGIN_SANDBOX_ENABLED=true
PLUGIN_PERMISSIONS_REQUIRED=filesystem.read
PLUGIN_MAX_MEMORY_MB=256
PLUGIN_MAX_CPU_SECONDS=30

# =============================================================================
# WORKFLOWS  (prefix: WORKFLOW_)
# =============================================================================
WORKFLOW_ENABLED=true
WORKFLOW_MAX_CONCURRENT=10
WORKFLOW_DEFAULT_TIMEOUT=3600
WORKFLOW_MAX_RETRIES=3
WORKFLOW_CHECKPOINT_INTERVAL=60
WORKFLOW_STATE_TTL=86400

# =============================================================================
# VERIFICATION LOOP  (prefix: VERIFICATION_)
# =============================================================================
VERIFICATION_ENABLED=true
VERIFICATION_MAX_ITERATIONS=3
VERIFICATION_DEFAULT_TIMEOUT=300
VERIFICATION_GENERATION_TEMPERATURE=0.3
VERIFICATION_REVIEW_TEMPERATURE=0.2
VERIFICATION_CORRECTION_TEMPERATURE=0.1
VERIFICATION_MIN_REVIEW_SCORE=70
VERIFICATION_REQUIRE_TESTS_PASS=true
VERIFICATION_REQUIRE_NO_SECURITY_ISSUES=true

# =============================================================================
# OBJECT STORAGE
# =============================================================================
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=superdev-artifacts
S3_PREFIX=artifacts
LOCAL_STORAGE_PATH=./data/storage

# =============================================================================
# MONITORING / OBSERVABILITY  (prefix: OTEL_)
# =============================================================================
# Grafana admin password (required by docker-compose; generate with:
# openssl rand -hex 16)
GRAFANA_ADMIN_PASSWORD=
OTEL_ENABLED=true
OTEL_TRACES_ENABLED=true
OTEL_METRICS_ENABLED=true
OTEL_SERVICE_NAME=superdev-api
OTEL_EXPORTER_ENDPOINT=http://localhost:4318
OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
OTEL_LOGS_ENDPOINT=http://localhost:4318/v1/logs
OTEL_TRACES_SAMPLER=traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_RESOURCE_ATTRIBUTES=service.name=superdev-api,deployment.environment=development
OTEL_PROMETHEUS_ENABLED=true
OTEL_PROMETHEUS_PORT=9090
OTEL_PROMETHEUS_PUSH_GATEWAY=
OTEL_GRAFANA_ENABLED=true
OTEL_GRAFANA_URL=http://localhost:3000
OTEL_GRAFANA_API_KEY=
OTEL_JAEGER_ENABLED=true
OTEL_JAEGER_AGENT_HOST=localhost
OTEL_JAEGER_AGENT_PORT=6831
OTEL_JAEGER_COLLECTOR_ENDPOINT=http://localhost:14268/api/traces
OTEL_SENTRY_DSN=
OTEL_SENTRY_ENVIRONMENT=development
OTEL_SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# SUPPLY CHAIN SECURITY
# =============================================================================
SBOM_ENABLED=true
SBOM_FORMAT=spdx-json
COSIGN_ENABLED=false
COSIGN_KEY_PATH=
COSIGN_PASSWORD=
SLSA_LEVEL=1

# =============================================================================
# SERVICE INTEGRATIONS (GitHub, Slack, Teams, etc.)
# =============================================================================
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
SLACK_VERIFICATION_TOKEN=
SLACK_BOT_TOKEN=
TEAMS_APP_ID=
ADMIN_EMAIL=admin@superdev.com
ADMIN_PASSWORD=SuperDev@2025

# =============================================================================
# INTER-SERVICE AUTH (internal microservice API keys)
# =============================================================================
BACKEND_API_KEY=dev-backend-key
AI_PLATFORM_API_KEY=dev-ai-key
AGENTS_API_KEY=dev-agents-key
WORKFLOW_API_KEY=dev-workflow-key
RUNTIME_API_KEY=dev-runtime-key

# =============================================================================
# SUPERDEV SDK / CLI
# =============================================================================
SUPERDEV_API_URL=http://localhost:8000
SUPERDEV_API_KEY=
SUPERDEV_ENV=development

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_KNOWLEDGE_BASE=true
FEATURE_VERIFICATION_LOOP=true
FEATURE_PLUGIN_MARKETPLACE=true
FEATURE_WORKFLOW_ENGINE=true
FEATURE_MULTI_TENANT=true
FEATURE_RATE_LIMITING=true
FEATURE_OBSERVABILITY=true
FEATURE_SUPPLY_CHAIN_SECURITY=false

# =============================================================================
# CI/CD
# =============================================================================
CI_REGISTRY=ghcr.io
CI_REGISTRY_USER=
CI_REGISTRY_PASSWORD=
CI_IMAGE_NAME=superdev/superdev
CI_IMAGE_TAG=latest

# =============================================================================
# KUBERNETES
# =============================================================================
K8S_NAMESPACE=superdev
K8S_CLUSTER_NAME=superdev-cluster
K8S_INGRESS_CLASS=nginx
K8S_CERT_MANAGER_ENABLED=true
K8S_CERT_ISSUER=letsencrypt-prod
